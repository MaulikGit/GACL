---
import Base from "../../layouts/Base.astro";
import { home, href, nav } from "../../lib/content";

const { products } = home;
const groups = nav.find((g) => g.label === "Products")?.children ?? [];
const cards = groups.map((g) => {
  const c = products.items.find((i: any) => i.href === g.href);
  return { title: g.label, href: g.href, image: c?.image ?? "" };
});
---

<Base title="Products" description={products.text}>
  <section class="sec">
    <div class="wrap">
      <div class="head reveal">
        <p class="t-eyebrow">Products</p>
        <h1 class="t-hero">{products.title}</h1>
        <p class="t-sub">{products.subtitle}</p>
        <p class="t-lead">{products.text}</p>
      </div>
      <div class="grid">
        {
          cards.map((c, i) => (
            <a class="card reveal" href={href(c.href)} style={`--d:${(i % 3) * 0.06}s`}>
              <div class="card__media">{c.image && <img src={c.image} alt="" loading={i < 3 ? "eager" : "lazy"} />}</div>
              <div class="card__body">
                <h2>{c.title}</h2>
                <span class="more">Learn more</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    background: var(--alt);
    overflow: hidden;
    color: var(--ink);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  .card:hover {
    text-decoration: none;
    transform: scale(1.02);
    box-shadow: var(--shadow-lg);
  }

  .card__media {
    aspect-ratio: 4 / 3;
    background: var(--alt-2);
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    display: grid;
    gap: 8px;
    padding: 24px 28px 30px;
  }

  .card__body h2 {
    font-size: 24px;
    letter-spacing: -0.024em;
  }
</style>
