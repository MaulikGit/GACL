---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { groups, productSlug, splitName } from "../../lib/products";

const all = groups.flatMap((g) =>
  g.products.map((p) => ({ ...splitName(p.name), group: g, slug: productSlug(p.name), apps: p.applications.slice(0, 3) })),
);
---

<Base title="Products" description="GACL’s chlor-alkali product portfolio: caustic soda, caustic potash, chlorotoluenes, hydrogen peroxide, chloromethanes, water treatment chemicals, sodium chlorate, phosphoric acid and hydrazine hydrate.">
  <PageHero
    eyebrow="Products"
    title="A complete chlor-alkali portfolio."
    lead="Ten product groups built around salt, electricity and chemistry. Every product comes with published specifications, applications, leaflets and safety data sheets."
    crumbs={[{ label: "Products" }]}
  />

  <section class="section">
    <div class="container">
      <div class="groups">
        {
          groups.map((g, i) => (
            <a href={`/products/${g.slug}/`} class="group reveal" style={`--d:${(i % 3) * 0.05}s`}>
              <div class="group__media">
                <img src={g.image} alt="" loading="lazy" />
              </div>
              <div class="group__body">
                <div class="group__meta">
                  <span class="icon-tile"><Icon name={g.icon} /></span>
                  <span class="chip chip--plain">{g.products.length} {g.products.length === 1 ? "product" : "products"}</span>
                </div>
                <h2 class="h3">{g.title}</h2>
                <p class="muted">{g.summary}</p>
                <span class="link-arrow">View products <Icon name="arrow" /></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" id="finder">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Product finder</p>
          <h2 class="h2">Find a product by name or use.</h2>
        </div>
        <label class="search">
          <Icon name="search" size={20} />
          <input type="search" placeholder="Search e.g. chloroform, water treatment, paper…" data-search aria-label="Search products" />
        </label>
      </div>
      <div class="filters" role="group" aria-label="Filter by group">
        <button type="button" class="filter is-on" data-filter="all">All</button>
        {groups.map((g) => <button type="button" class="filter" data-filter={g.slug}>{g.short}</button>)}
      </div>
      <ul class="finder" data-finder>
        {
          all.map((p) => (
            <li data-group={p.group.slug} data-text={`${p.base} ${p.formula} ${p.group.title} ${p.apps.join(" ")}`.toLowerCase()}>
              <a href={`/products/${p.group.slug}/#${p.slug}`} class="finder__item">
                <span class="finder__name">
                  <strong>{p.base}</strong>
                  {p.formula && <code>{p.formula}</code>}
                </span>
                <span class="finder__group">{p.group.short}</span>
                <span class="finder__apps">{p.apps.join(" · ")}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="finder__empty" data-empty hidden>No products match your search. <a href="/contact/" class="link-arrow">Ask our team <Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-search]")!;
  const items = [...document.querySelectorAll<HTMLLIElement>("[data-finder] li")];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  let group = "all";
  const apply = () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const ok = (group === "all" || li.dataset.group === group) && (!q || li.dataset.text!.includes(q));
      li.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  };
  input.addEventListener("input", apply);
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      group = b.dataset.filter!;
      buttons.forEach((x) => x.classList.toggle("is-on", x === b));
      apply();
    }),
  );
</script>

<style>
  .groups {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .group {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease), border-color 0.3s;
  }

  .group:hover {
    box-shadow: var(--shadow-2);
    transform: translateY(-3px);
    border-color: var(--brand-200);
  }

  .group__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .group__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .group:hover .group__media img {
    transform: scale(1.05);
  }

  .group__body {
    display: grid;
    gap: 12px;
    padding: 22px 24px 26px;
    flex: 1;
    align-content: start;
  }

  .group__body p {
    font-size: 15px;
  }

  .group__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: -46px;
  }

  .group__meta .icon-tile {
    background: #fff;
    box-shadow: var(--shadow-1);
    width: 52px;
    height: 52px;
  }

  .group__meta .chip {
    margin-top: 30px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    min-height: 56px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--muted);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search:focus-within {
    border-color: var(--brand-500);
    box-shadow: 0 0 0 4px var(--brand-50);
  }

  .search input {
    flex: 1;
    border: 0;
    outline: 0;
    font: inherit;
    font-size: 16px;
    background: transparent;
    color: var(--ink);
    min-width: 0;
  }

  .filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 6px;
    margin-bottom: 20px;
    scrollbar-width: none;
  }

  .filter {
    flex-shrink: 0;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter:hover {
    border-color: var(--brand-200);
  }

  .filter.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .finder {
    list-style: none;
    margin: 0;
    padding: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }

  .finder li + li {
    border-top: 1px solid var(--line);
  }

  .finder__item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 20px;
    align-items: center;
    padding: 18px 22px;
    transition: background 0.2s;
  }

  .finder__item:hover {
    background: var(--brand-50);
  }

  @media (min-width: 900px) {
    .finder__item {
      grid-template-columns: 1.3fr 0.7fr 1.4fr auto;
    }
  }

  .finder__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .finder__name code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 12.5px;
    color: var(--brand-700);
    background: var(--brand-50);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .finder__group {
    font-size: 14px;
    color: var(--brand-600);
    font-weight: 500;
  }

  .finder__apps {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .finder__group,
    .finder__apps {
      grid-column: 1;
    }

    .finder__item > :global(svg) {
      grid-row: 1;
      grid-column: 2;
    }
  }

  .finder__item > :global(svg) {
    color: var(--muted);
  }

  .finder__empty {
    padding: 32px;
    text-align: center;
    color: var(--muted);
  }
</style>
