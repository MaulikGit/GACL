---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { groups, productSlug, splitName, type Group } from "../../lib/products";

export function getStaticPaths() {
  return groups.map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props as { group: Group };
const others = groups.filter((g) => g.slug !== group.slug);
const isUnitCell = (s: string) => /^(%|ppm|mm|gm|g\/|kg|°c|deg)/i.test(s);
---

<Base title={group.title} description={group.summary} image={group.image}>
  <PageHero
    eyebrow="Product group"
    title={group.title}
    lead={group.summary}
    image={group.image}
    imageAlt={group.title}
    crumbs={[{ label: "Products", href: "/products/" }, { label: group.short }]}
  >
    <div class="facts">
      {
        group.facts.map((f) => (
          <div class="fact">
            <strong>{f.value}</strong>
            <span>{f.label}</span>
          </div>
        ))
      }
    </div>
    <div class="tags">
      {group.industries.map((i) => <span class="chip chip--plain">{i}</span>)}
    </div>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <aside class="toc" aria-label="Products in this group">
        <p class="toc__title">In this group</p>
        <ol>
          {
            group.products.map((p) => (
              <li>
                <a href={`#${productSlug(p.name)}`}>{splitName(p.name).base}</a>
              </li>
            ))
          }
        </ol>
        <a href="/contact/" class="btn btn--sm toc__cta">Enquire now <Icon name="arrow" /></a>
      </aside>

      <div class="products">
        {
          group.products.map((p) => {
            const { base, formula } = splitName(p.name);
            return (
              <article class="product reveal" id={productSlug(p.name)}>
                <header class="product__head">
                  <div>
                    <h2 class="product__name">{base}</h2>
                    {formula && <code class="product__formula">{formula}</code>}
                  </div>
                  {p.documents.length > 0 && (
                    <div class="product__docs">
                      {p.documents.map((d) => (
                        <a href={d.url} class="btn btn--ghost btn--sm" target="_blank" rel="noopener">
                          <Icon name={d.label.toLowerCase().includes("msds") ? "shield" : "doc"} size={16} />
                          {d.label.toLowerCase().includes("msds") ? "Safety data sheet" : d.label}
                        </a>
                      ))}
                    </div>
                  )}
                </header>

                <div class="product__grid">
                  {p.specs.length > 0 && (
                    <div class="product__specs">
                      <h3 class="product__label">
                        Specifications{p.note && <span class="muted"> · {p.note}</span>}
                      </h3>
                      {p.specs.map((table) => {
                        const [head, ...rows] = table;
                        const skipFirst = head[0]?.toLowerCase().startsWith("sr");
                        const cols = skipFirst ? head.slice(1) : head;
                        return (
                          <div class="table-wrap">
                            <table class="table">
                              <thead>
                                <tr>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
                              </thead>
                              <tbody>
                                {rows.map((r) => (
                                  <tr>
                                    {(skipFirst ? r.slice(1) : r).map((c, i) => (
                                      <td class:list={{ num: i > 0 || isUnitCell(c) }}>{c}</td>
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  <div class="product__side">
                    {p.applications.length > 0 && (
                      <div>
                        <h3 class="product__label">Applications</h3>
                        <ul class="apps">
                          {p.applications.map((a) => (
                            <li>
                              <Icon name="check" size={16} />
                              {a}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {p.caution && (
                      <div class="caution">
                        <Icon name="warning" size={18} />
                        <p>
                          <strong>Caution:</strong> {p.caution}
                        </p>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Explore more</p>
        <h2 class="h2">Other product groups</h2>
      </div>
      <div class="others">
        {
          others.map((g) => (
            <a href={`/products/${g.slug}/`} class="card other">
              <span class="icon-tile">
                <Icon name={g.icon} />
              </span>
              <span class="other__name">{g.short}</span>
              <Icon name="arrow" size={18} />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .fact {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
    min-width: 160px;
  }

  .fact strong {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--brand-700);
    letter-spacing: -0.02em;
  }

  .fact span {
    font-size: 13px;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .layout {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: 240px 1fr;
      gap: 56px;
      align-items: start;
    }
  }

  .toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .toc {
      display: grid;
      gap: 14px;
      position: sticky;
      top: 140px;
    }
  }

  .toc__title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }

  .toc ol a {
    display: block;
    padding: 8px 0 8px 16px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 14.5px;
    color: var(--ink-2);
    transition: color 0.2s, border-color 0.2s;
  }

  .toc ol a:hover {
    color: var(--brand-600);
    border-color: var(--brand-500);
  }

  .toc__cta {
    justify-self: start;
  }

  .products {
    display: grid;
    gap: 28px;
  }

  .product {
    scroll-margin-top: 140px;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .product__head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 22px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .product__name {
    font-size: clamp(22px, 2.4vw, 28px);
  }

  .product__formula {
    display: inline-block;
    margin-top: 10px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 13px;
    color: var(--brand-700);
    background: var(--brand-50);
    padding: 4px 10px;
    border-radius: 8px;
  }

  .product__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .product__grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .product__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 36px;
    }
  }

  .product__label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .product__label .muted {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  .product__specs {
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
  }

  .product__specs .table {
    min-width: 0;
    font-size: 14px;
  }

  .product__specs td.num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .product__side {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .apps li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .apps :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--green-500);
  }

  .caution {
    display: flex;
    gap: 10px;
    padding: 14px 16px;
    border-radius: 14px;
    background: #fff8e6;
    border: 1px solid #f6dfa0;
    font-size: 14px;
    color: #6b4f00;
  }

  .caution :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .others {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .other {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
  }

  .other__name {
    flex: 1;
    font-weight: 600;
  }

  .other > :global(svg:last-child) {
    color: var(--muted);
  }
</style>
