---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { news } from "../../data/site";

const stories = [
  ...news.map((n, i) => ({ ...n, image: ["/images/plant-day.webp", "/images/hero-plant.webp", "/images/ceu.webp"][i] })),
  { date: "2023-01-01", title: "First dispatch of Hydrazine Hydrate (80%) and Purified Phosphoric Acid (85%) from Dahej", href: "https://gacl.com/gacl-news/", image: "/images/hh-dispatch.webp" },
];
const fmt = (d: string) => new Date(d).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
const [lead, ...rest] = stories;
---

<Base title="Media" description="GACL news, press releases and events.">
  <PageHero
    eyebrow="Media"
    title="News & events"
    lead="Plant dedications, first dispatches, awards and community events from across GACL."
    crumbs={[{ label: "Media" }]}
  />

  <section class="section">
    <div class="container">
      <a href={lead.href} class="feature reveal" target="_blank" rel="noopener">
        <img src={lead.image} alt="" loading="lazy" />
        <div class="feature__copy">
          <span class="chip">Latest</span>
          <time datetime={lead.date}>{fmt(lead.date)}</time>
          <h2 class="h2">{lead.title}</h2>
          <span class="link-arrow">Read the story <Icon name="arrow-up-right" /></span>
        </div>
      </a>
      <div class="grid grid-3 stories">
        {
          rest.map((s, i) => (
            <a href={s.href} class="story reveal" style={`--d:${i * 0.05}s`} target="_blank" rel="noopener">
              <img src={s.image} alt="" loading="lazy" />
              <time datetime={s.date}>{s.date.endsWith("01-01") ? s.date.slice(0, 4) : fmt(s.date)}</time>
              <h3>{s.title}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Events</p>
        <h2 class="h2">Meet us at industry events.</h2>
      </div>
      <div class="events">
        <img src="/images/expo-stand.webp" alt="GACL pavilion at a chemical industry exhibition" loading="lazy" class="reveal" />
        <img src="/images/expo-team.webp" alt="GACL team at an exhibition" loading="lazy" class="reveal" />
      </div>
      <a href="https://gacl.com/gacl-events/" class="link-arrow events__more" target="_blank" rel="noopener">All events <Icon name="arrow-up-right" /></a>
    </div>
  </section>
</Base>

<style>
  .feature {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    margin-bottom: 24px;
    transition: box-shadow 0.3s;
  }

  .feature:hover {
    box-shadow: var(--shadow-2);
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .feature img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .feature__copy {
    display: grid;
    gap: 14px;
    align-content: center;
    justify-items: start;
    padding: clamp(24px, 4vw, 48px);
  }

  time {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-600);
  }

  .story {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .story img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 16px;
    transition: transform 0.6s var(--ease);
  }

  .story:hover img {
    transform: scale(1.02);
  }

  .story h3 {
    font-size: 18px;
    line-height: 1.35;
  }

  .story:hover h3 {
    color: var(--brand-700);
  }

  .events {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 800px) {
    .events {
      grid-template-columns: 1fr 1fr;
    }
  }

  .events img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 20px;
  }

  .events__more {
    margin-top: 20px;
  }
</style>
