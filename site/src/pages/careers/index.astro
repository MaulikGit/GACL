---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";

const advantages = [
  { icon: "heartbeat", title: "Employee well-being", text: "A 24×7 occupational health centre, regular check-ups, wellness workshops and tie-ups with hospitals in Vadodara, Surat and Bharuch." },
  { icon: "briefcase", title: "Benefits that last", text: "Comprehensive benefits, post-retirement mediclaim and a Long Service Award that honours decades of commitment." },
  { icon: "education", title: "Training & careers", text: "Structured training and development, from plant operations to leadership, so people grow with the company." },
  { icon: "users", title: "Equal opportunity", text: "A workplace where everyone, irrespective of gender or background, is valued, respected and heard." },
  { icon: "factory", title: "Facilities", text: "Residential colonies, a modern gymnasium, sports grounds and community spaces near our complexes." },
  { icon: "spark", title: "Meaningful work", text: "Build India’s chemical self-reliance with technology firsts like membrane cells and indigenous Hydrazine Hydrate." },
];
const gallery = [
  { src: "/images/life-foundation-day.webp", alt: "Foundation Day celebrations" },
  { src: "/images/life-yoga.webp", alt: "International Yoga Day at GACL" },
  { src: "/images/life-gym.webp", alt: "Employee gymnasium" },
];
---

<Base title="Careers" description="Life at GACL: the GACL Parivaar, employee well-being, benefits, training and current openings.">
  <PageHero
    eyebrow="Careers · Life at GACL"
    title="Not just a career. A brighter future."
    lead="We call our people the GACL Parivaar. Engineers, chemists and professionals from many backgrounds work together to drive innovation, safety and sustainability."
    image="/images/life-foundation-day.webp"
    imageAlt="GACL employees at Foundation Day"
    crumbs={[{ label: "Careers" }]}
  >
    <div class="actions">
      <a href="https://gacl.com/current-openings/" class="btn" target="_blank" rel="noopener">Current openings <Icon name="arrow-up-right" /></a>
      <a href="#advantage" class="btn btn--ghost">Why GACL</a>
    </div>
  </PageHero>

  <section class="section" id="advantage">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The GACL advantage</p>
        <h2 class="h2">Why people build their careers here.</h2>
      </div>
      <div class="grid grid-3">
        {
          advantages.map((a, i) => (
            <article class="card adv reveal" style={`--d:${(i % 3) * 0.05}s`}>
              <span class="icon-tile">
                <Icon name={a.icon} />
              </span>
              <h3 class="h3">{a.title}</h3>
              <p class="muted">{a.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Life at GACL</p>
        <h2 class="h2">Work, wellness and celebration.</h2>
      </div>
      <div class="gallery">
        {gallery.map((g) => <img src={g.src} alt={g.alt} loading="lazy" class="reveal" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .adv {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .gallery {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 800px) {
    .gallery {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: 1fr 1fr;
    }

    .gallery img:first-child {
      grid-row: span 2;
    }
  }

  .gallery img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    border-radius: 20px;
  }
</style>
