---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { highlights, sectors, locations, stats } from "../../data/site";

const pillars = [
  {
    title: "A leader in caustic soda",
    text: "Starting from 37,425 TPA in 1976, we now run 8,52,400 TPA of capacity with our subsidiary and supply over a fifth of India’s caustic soda.",
    icon: "factory",
  },
  {
    title: "Setting new benchmarks",
    text: "A nationwide dealer network, in-house R&D and sites close to salt, ports and customers keep us competitive at home and abroad.",
    icon: "chart",
  },
  {
    title: "Diverse offerings, global reach",
    text: "35+ products for more than 5,000 customers, from local manufacturers to global corporations in over 60 countries.",
    icon: "globe",
  },
  {
    title: "Committed to national prosperity",
    text: "With CSIR-IICT we developed an eco-friendly Hydrazine Hydrate process, patented in India and the US, that replaces imports.",
    icon: "flask",
  },
];
---

<Base title="The Corporate World" description="About Gujarat Alkalies and Chemicals Limited: a chlor-alkali leader established in 1973 in Vadodara and promoted by the Government of Gujarat.">
  <PageHero
    eyebrow="The corporate world"
    title="Roots in Gujarat, nourishing India."
    lead="GACL was set up in 1973 in Vadodara with the support of the Government of Gujarat. Five decades on, we are one of India’s largest chlor-alkali companies and a key contributor to an Atmanirbhar Bharat."
    image="/images/plant-day.webp"
    imageAlt="GACL plant at Dahej"
    crumbs={[{ label: "Company", href: "/company/" }, { label: "The Corporate World" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-4 kpis">
        {
          stats.map((s) => (
            <div class="kpi reveal">
              <strong>
                {s.display ?? s.value}
                <span>{s.suffix}</span>
              </strong>
              <p class="muted">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What defines us</p>
        <h2 class="h2">Built on technology, research and responsible growth.</h2>
      </div>
      <div class="grid grid-2">
        {
          pillars.map((p, i) => (
            <article class="card pillar reveal" style={`--d:${(i % 2) * 0.06}s`}>
              <span class="icon-tile">
                <Icon name={p.icon} />
              </span>
              <h3 class="h3">{p.title}</h3>
              <p class="muted">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="split__media reveal">
        <img src="/images/cell-house.webp" alt="Membrane cell house" loading="lazy" />
      </div>
      <div class="split__copy">
        <p class="eyebrow">Firsts that matter</p>
        <h2 class="h2">Leading the industry towards cleaner chemistry.</h2>
        <div class="firsts">
          {
            highlights.map((h) => (
              <div class="first reveal">
                <span class:list={["icon-tile", { "icon-tile--green": h.icon === "leaf" }]}>
                  <Icon name={h.icon} />
                </span>
                <div>
                  <h3>{h.title}</h3>
                  <p class="muted">{h.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Industries</p>
        <h2 class="h2">Our products touch {sectors.length}+ sectors.</h2>
      </div>
      <ul class="sectors">
        {sectors.map((s) => <li class="chip chip--plain">{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Where we operate</p>
        <h2 class="h2">Four complexes across Vadodara and Dahej.</h2>
      </div>
      <div class="grid grid-3">
        {
          locations.map((l) => (
            <article class="card loc reveal">
              <span class="icon-tile">
                <Icon name="pin" />
              </span>
              <h3 class="h3">{l.name}</h3>
              <p class="muted">{l.address}</p>
              <a href={l.map} class="link-arrow" target="_blank" rel="noopener">
                Open in maps <Icon name="arrow-up-right" />
              </a>
            </article>
          ))
        }
      </div>
      <div class="more">
        <a href="/company/philosophy/" class="card more__link"><span>Corporate Philosophy</span><Icon name="arrow" /></a>
        <a href="/company/governing-body/" class="card more__link"><span>Governing Body</span><Icon name="arrow" /></a>
        <a href="/company/journey/" class="card more__link"><span>Our Journey</span><Icon name="arrow" /></a>
        <a href="/company/honours/" class="card more__link"><span>Honours & Recognitions</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .kpi {
    padding: 8px 0;
    border-top: 2px solid var(--brand-500);
    padding-top: 20px;
  }

  .kpi strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand-700);
    margin-bottom: 6px;
  }

  .kpi strong span {
    font-size: 0.5em;
    color: var(--brand-500);
  }

  .pillar,
  .loc {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .split {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .split {
      grid-template-columns: 1fr 1.1fr;
      gap: 72px;
    }
  }

  .split__media img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
  }

  .split__copy {
    display: grid;
    gap: 18px;
  }

  .firsts {
    display: grid;
    gap: 22px;
    margin-top: 10px;
  }

  .first {
    display: flex;
    gap: 16px;
  }

  .first h3 {
    font-size: 17px;
    margin-bottom: 4px;
  }

  .sectors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 900px;
  }

  .sectors .chip {
    font-size: 15px;
    padding: 10px 18px;
    background: #fff;
  }

  .more {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-top: 56px;
  }

  .more__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    font-weight: 600;
  }

  .more__link :global(svg) {
    color: var(--brand-600);
  }
</style>
