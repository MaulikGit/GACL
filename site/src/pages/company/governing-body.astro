---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { board } from "../../data/site";

const initials = (name: string) =>
  name
    .replace(/^(Dr\.|Shri|Smt\.)\s+/, "")
    .replace(/,.*$/, "")
    .split(/\s+/)
    .filter((w) => /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join("");
const [chair, md, ...rest] = board;
---

<Base title="Governing Body" description="The Board of Directors of Gujarat Alkalies and Chemicals Limited.">
  <PageHero
    eyebrow="Governing body"
    title="Exceptional leadership. Excellent governance."
    lead="GACL’s Board brings together senior administrators and independent experts to guide the company’s strategy and safeguard shareholder interests."
    crumbs={[{ label: "Company", href: "/company/" }, { label: "Governing Body" }]}
  />

  <section class="section">
    <div class="container">
      <div class="leads">
        {
          [chair, md].map((p) => (
            <article class="lead-card reveal">
              <span class="avatar avatar--lg">{initials(p.name)}</span>
              <div>
                <p class="eyebrow">{p.role}</p>
                <h2 class="h3">{p.name}</h2>
              </div>
            </article>
          ))
        }
      </div>
      <div class="members">
        {
          rest.map((p, i) => (
            <article class="card member reveal" style={`--d:${(i % 3) * 0.05}s`}>
              <span class="avatar">{initials(p.name)}</span>
              <div>
                <h3>{p.name}</h3>
                <p class="muted">{p.role}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .leads {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media (min-width: 800px) {
    .leads {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lead-card {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--brand-100);
    background: linear-gradient(140deg, var(--brand-50), #fff 70%);
  }

  .lead-card .eyebrow {
    margin-bottom: 8px;
  }

  .members {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .member {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .member h3 {
    font-size: 17px;
    margin-bottom: 2px;
  }

  .member p {
    font-size: 14px;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-600), var(--brand-500) 60%, var(--green-500));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
  }

  .avatar--lg {
    width: 84px;
    height: 84px;
    font-size: 26px;
  }
</style>
