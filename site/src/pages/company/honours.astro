---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { honours, certificates } from "../../data/site";
---

<Base title="Honours & Recognitions" description="Awards and certifications earned by GACL for safety, energy efficiency, governance and CSR.">
  <PageHero
    eyebrow="Honours & recognitions"
    title="Excellence, recognised."
    lead="National awards for safety, energy conservation, governance and community work — and certifications that back our quality every day."
    crumbs={[{ label: "Company", href: "/company/" }, { label: "Honours & Recognitions" }]}
  />

  <section class="section">
    <div class="container">
      <div class="awards">
        {
          honours.map((h, i) => (
            <article class="card award reveal" style={`--d:${(i % 2) * 0.05}s`}>
              <div class="award__year">{h.year}</div>
              <div class="award__body">
                <span class="icon-tile">
                  <Icon name="award" />
                </span>
                <div>
                  <h2 class="h3">{h.title}</h2>
                  <p class="award__by">{h.by}</p>
                  <p class="muted">{h.text}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Certifications</p>
        <h2 class="h2">Certified systems, certified products.</h2>
      </div>
      <div class="grid grid-4">
        {
          certificates.map((c) => (
            <div class="card cert reveal">
              <Icon name="badge" />
              <strong>{c.code}</strong>
              <span class="muted">{c.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .awards {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .awards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .award {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: start;
  }

  .award__year {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--brand-600);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--brand-50);
  }

  .award__body {
    display: grid;
    gap: 14px;
  }

  .award__by {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    margin: 6px 0;
  }

  .cert {
    display: grid;
    gap: 6px;
  }

  .cert :global(svg) {
    color: var(--brand-500);
    margin-bottom: 8px;
  }

  .cert strong {
    font-family: var(--font-display);
    font-size: 20px;
  }
</style>
