---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";

const energy = [
  { icon: "wind", value: "171.45 MW", label: "Wind power", note: "Ten phases of wind farms across Kutch and Saurashtra since 2008." },
  { icon: "sun", value: "36.62 MW", label: "Solar power", note: "Solar parks including Charanka, Patan." },
  { icon: "bolt", value: "208.07 MW", label: "Total renewables", note: "All for captive use at our plants." },
  { icon: "h2", value: "~8 MT/day", label: "Green hydrogen", note: "Recovered as a by-product of membrane electrolysis." },
];
const initiatives = [
  { icon: "spark", title: "Membrane cell pioneer", text: "In 1989 we became the first Indian caustic soda maker to replace mercury cells with membrane technology, and we finished the switch in 1994." },
  { icon: "bolt", title: "100 MW round-the-clock green power", text: "An MoU with NTPC Renewable Energy covers 100 MW of firm green power and joint work on green methanol and ammonia for our own use." },
  { icon: "leaf", title: "500 KLD bioethanol with GAIL", text: "A planned bioethanol plant using maize and broken rice, producing a petrol additive that cuts urban pollution and supports farm incomes." },
  { icon: "drop", title: "Mangroves and green belts", text: "Green belts at Vadodara and Dahej, 40 hectares of mangroves planted at Dahej, and regular tree planting in nearby villages." },
  { icon: "recycle", title: "Cleaner processes", text: "First in India to adopt the Sulphate Removal System at Dahej, plus a green belt built on a former solid-waste landfill site." },
  { icon: "chart", title: "Energy efficiency", text: "Energy-efficient electrolyser elements and a national award under PAT Cycle II for the Dahej Complex." },
];
---

<Base title="Sustainability" description="GACL’s environmental commitments: 208 MW of renewable energy, green hydrogen, membrane cell technology, mangroves and bioethanol." image="/images/renewables.webp">
  <PageHero
    eyebrow="Sustainability · Environment"
    green
    title="Building a greener chlor-alkali industry."
    lead="Caring for the environment has been part of how GACL works since 1989. Today we run our plants partly on our own wind and solar power and keep cutting the footprint of every tonne we make."
    image="/images/renewables.webp"
    imageAlt="Solar panels and wind turbines"
    crumbs={[{ label: "Sustainability" }]}
  />

  <section class="section">
    <div class="container">
      <div class="energy">
        {
          energy.map((e, i) => (
            <div class="energy__item reveal" style={`--d:${i * 0.05}s`}>
              <span class="icon-tile icon-tile--green">
                <Icon name={e.icon} />
              </span>
              <strong>{e.value}</strong>
              <span class="energy__label">{e.label}</span>
              <p class="muted">{e.note}</p>
            </div>
          ))
        }
      </div>
      <p class="note muted">More than 25% of the electricity we use comes from renewable sources.</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--green">Initiatives</p>
        <h2 class="h2">From technology to trees.</h2>
      </div>
      <div class="grid grid-3">
        {
          initiatives.map((it, i) => (
            <article class="card init reveal" style={`--d:${(i % 3) * 0.05}s`}>
              <span class="icon-tile icon-tile--green">
                <Icon name={it.icon} />
              </span>
              <h3 class="h3">{it.title}</h3>
              <p class="muted">{it.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container band">
      <img src="/images/wind.webp" alt="GACL wind farm, Kutch" loading="lazy" class="band__img" />
      <div class="band__copy">
        <p class="eyebrow eyebrow--green">Explore more</p>
        <h2 class="h2">Sustainability is safety, people and governance too.</h2>
        <div class="links">
          <a href="/sustainability/safety/" class="card link"><Icon name="shield" /><span>Safety & Health</span><Icon name="arrow" /></a>
          <a href="/sustainability/csr/" class="card link"><Icon name="heart" /><span>Corporate Social Responsibility</span><Icon name="arrow" /></a>
          <a href="/sustainability/governance/" class="card link"><Icon name="scale" /><span>Governance, certificates & BRSR</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .energy {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .energy {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .energy {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .energy__item {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 26px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: linear-gradient(170deg, var(--green-50), #fff 60%);
  }

  .energy__item strong {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--green-700);
  }

  .energy__label {
    font-weight: 600;
  }

  .energy__item p {
    font-size: 14px;
  }

  .note {
    margin-top: 20px;
    font-size: 14px;
  }

  .init {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .band {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .band {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
    }
  }

  .band__img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .band__copy {
    display: grid;
    gap: 18px;
  }

  .links {
    display: grid;
    gap: 12px;
    margin-top: 10px;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    font-weight: 600;
  }

  .link span {
    flex: 1;
  }

  .link :global(svg:first-child) {
    color: var(--green-500);
  }

  .link :global(svg:last-child) {
    color: var(--muted);
  }
</style>
