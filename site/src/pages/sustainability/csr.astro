---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";

const areas = [
  { icon: "heartbeat", title: "Healthcare & hygiene" },
  { icon: "education", title: "Education" },
  { icon: "heart", title: "Support for special children" },
  { icon: "drop", title: "Water & sanitation" },
  { icon: "briefcase", title: "Sustainable livelihoods" },
  { icon: "spark", title: "Skill development" },
  { icon: "users", title: "Women’s empowerment" },
  { icon: "leaf", title: "Environmental conservation" },
  { icon: "book", title: "Art, culture & heritage" },
];
const principles = [
  { title: "Community engagement", text: "We work as a socially responsible corporation, building long-term relationships with the villages and towns around our complexes." },
  { title: "Broad impact", text: "Programmes run through GACL Foundation Trust, our CSR arm, across health, education, livelihoods and the environment." },
  { title: "Aligned with national priorities", text: "Our CSR projects support government programmes, so every rupee adds to work already under way." },
];
---

<Base title="CSR" description="GACL Foundation Trust’s CSR programmes in healthcare, education, special children, sanitation, livelihoods and environment.">
  <PageHero
    eyebrow="Corporate social responsibility"
    green
    title="Social responsibility is our ethos."
    lead="Through GACL Foundation Trust we invest in communities across Gujarat, from schools and health camps to a home for mentally differently-abled children."
    image="/images/csr-education.webp"
    imageAlt="GACL CSR education programme"
    crumbs={[{ label: "Sustainability", href: "/sustainability/" }, { label: "CSR" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          principles.map((p, i) => (
            <article class="card principle reveal" style={`--d:${i * 0.05}s`}>
              <span class="principle__num">0{i + 1}</span>
              <h2 class="h3">{p.title}</h2>
              <p class="muted">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--green">Focus areas</p>
        <h2 class="h2">Where we make a difference</h2>
      </div>
      <div class="areas">
        {
          areas.map((a, i) => (
            <div class="area reveal" style={`--d:${(i % 3) * 0.04}s`}>
              <span class="icon-tile icon-tile--green">
                <Icon name={a.icon} />
              </span>
              <span>{a.title}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container award">
      <span class="icon-tile"><Icon name="award" /></span>
      <div>
        <p class="eyebrow">Recognition</p>
        <h2 class="h3">National CSR Award 2025, World HRD Congress</h2>
        <p class="muted">For GACL Foundation Trust’s Home for Mentally Differently-abled Children (HMDC) project. We also won 1st prize for CSR at the GEO Excellence Awards 2024.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .principle {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .principle__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    color: var(--green-700);
  }

  .areas {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .area {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    font-weight: 600;
  }

  .award {
    display: flex;
    gap: 20px;
    align-items: start;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--brand-100);
    background: linear-gradient(140deg, var(--brand-50), #fff 70%);
  }

  .award .eyebrow {
    margin-bottom: 8px;
  }

  .award .muted {
    margin-top: 8px;
    max-width: 720px;
  }
</style>
