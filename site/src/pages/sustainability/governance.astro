---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { certificates, philosophy } from "../../data/site";

const brsr = ["2025-26", "2024-25", "2023-24", "2022-23"];
---

<Base title="Governance & Certificates" description="Corporate governance at GACL, its management system certifications and Business Responsibility & Sustainability Reports.">
  <PageHero
    eyebrow="Governance"
    title="Success that is responsible and ethical."
    lead="Strong governance has guided GACL for five decades. Clear policies and independent oversight keep us accountable, fair and transparent to every stakeholder."
    crumbs={[{ label: "Sustainability", href: "/sustainability/" }, { label: "Governance & Certificates" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-4">
        {
          philosophy.values.map((v) => (
            <div class="card gv reveal">
              <span class="icon-tile">
                <Icon name={v.icon} />
              </span>
              <h2 class="h3">{v.title}</h2>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our certificates</p>
        <h2 class="h2">Independently certified.</h2>
      </div>
      <div class="certs">
        {
          certificates.map((c) => (
            <div class="cert reveal">
              <span class="cert__seal"><Icon name="badge" /></span>
              <strong>{c.code}</strong>
              <span class="muted">{c.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Reporting</p>
          <h2 class="h2">Business Responsibility & Sustainability Reports</h2>
        </div>
        <a href="https://gacl.com/brsr-reports/" class="link-arrow" target="_blank" rel="noopener">All reports on gacl.com <Icon name="arrow-up-right" /></a>
      </div>
      <ul class="reports">
        {
          brsr.map((y) => (
            <li>
              <a href="https://gacl.com/brsr-reports/" target="_blank" rel="noopener" class="report">
                <Icon name="doc" />
                <span>BRSR FY {y}</span>
                <span class="chip chip--plain">PDF</span>
                <Icon name="download" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .gv {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .certs {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .cert {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 28px 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .cert__seal {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    margin-bottom: 10px;
    color: var(--brand-600);
    background: radial-gradient(circle, #fff 55%, var(--brand-50) 56%);
    border: 1px dashed var(--brand-200);
  }

  .cert strong {
    font-family: var(--font-display);
    font-size: 19px;
  }

  .reports {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }

  .reports li + li {
    border-top: 1px solid var(--line);
  }

  .report {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .report:hover {
    background: var(--brand-50);
  }

  .report span:nth-child(2) {
    flex: 1;
  }

  .report :global(svg) {
    color: var(--brand-600);
  }
</style>
