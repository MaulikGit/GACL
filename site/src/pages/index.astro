---
import Base from "../layouts/Base.astro";
import { home, href, youtubeId } from "../lib/content";

const { notice, slides, figures, company, products, clients, green, services, media, testimonials, investor, quick } = home;
const videoId = company.video ? youtubeId(company.video) : null;
const half = Math.ceil(clients.logos.length / 2);
const logoRows = [clients.logos.slice(0, half), clients.logos.slice(half)];
---

<Base title="Home">
  {
    notice && (
      <a class="ribbon" href={notice.href} target="_blank" rel="noopener">
        <span>{notice.text}</span>
        <span class="more">View</span>
      </a>
    )
  }

  <!-- Hero slider -->
  <section class="hero" aria-roledescription="carousel" aria-label="Highlights" data-hero>
    <div class="hero__track">
      {
        slides.map((s: any, i: number) => (
          <article class:list={["slide", { "is-on": i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-slide>
            <img src={s.image} alt="" class="slide__img" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} />
            <div class="slide__shade" />
            <div class="slide__copy wrap">
              {s.title ? (
                <>
                  <h1 class="slide__title">{s.title}</h1>
                  <p class="slide__text">{s.text}</p>
                </>
              ) : (
                <p class="slide__sentence" set:html={s.html} />
              )}
            </div>
          </article>
        ))
      }
    </div>
    <div class="hero__controls wrap">
      <div class="hero__dots" role="tablist">
        {slides.map((_: any, i: number) => <button type="button" role="tab" aria-label={`Slide ${i + 1}`} aria-selected={i === 0 ? "true" : "false"} data-dot />)}
      </div>
      <button type="button" class="hero__pause" aria-label="Pause" data-pause>
        <span class="i-pause" />
      </button>
    </div>
  </section>

  <!-- Figures -->
  <section class="sec figures">
    <div class="wrap">
      <p class="t-eyebrow center figures__title reveal">{figures.title}</p>
      <div class="figures__grid">
        {
          figures.items.map((f: any, i: number) => (
            <div class="figure reveal" style={`--d:${i * 0.08}s`}>
              {f.icon && <img src={f.icon} alt="" class="figure__icon" loading="lazy" />}
              <p class="figure__value">
                {f.value ? (
                  <>
                    <span data-count={f.value}>{Number(f.value).toLocaleString("en-IN")}</span>
                    {f.title.replace(f.value, "").trim() && <span class="figure__unit">{f.title.replace(f.value, "").trim()}</span>}
                  </>
                ) : (
                  f.title
                )}
              </p>
              <p class="figure__text" set:html={f.html} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Company -->
  <section class="sec sec--alt">
    <div class="wrap company">
      <div class="company__media reveal">
        <img src={company.image} alt="" loading="lazy" />
        <div class="company__badge">
          <span>{company.badge}</span>
          {
            videoId && (
              <button type="button" class="pill pill--light" data-video={videoId}>
                <span class="i-play" /> Play Video
              </button>
            )
          }
        </div>
      </div>
      <div class="company__copy reveal" style="--d:.08s">
        <p class="t-eyebrow">Our Company</p>
        <h2 class="t-sub company__title">{company.eyebrow}</h2>
        {company.paragraphs.map((p: string) => <p class="rich" set:html={p} />)}
        <a class="more" href={href(company.link)}>Read more</a>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="sec products">
    <div class="wrap">
      <div class="head reveal">
        <h2 class="t-display">{products.title}</h2>
        <p class="t-sub">{products.subtitle}</p>
        <p class="t-lead">{products.text}</p>
      </div>
    </div>
    <div class="rail" data-rail>
      <ul class="rail__track" data-track>
        {
          products.items.map((p: any) => (
            <li class="rail__item">
              <a class="pcard" href={href(p.href)}>
                <div class="pcard__media">
                  <img src={p.image} alt="" loading="lazy" />
                </div>
                <div class="pcard__body">
                  <h3>{p.title}</h3>
                  <span class="more">Learn more</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="rail__nav wrap">
        <button type="button" class="rail__btn" aria-label="Previous" data-prev>‹</button>
        <button type="button" class="rail__btn" aria-label="Next" data-next>›</button>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="sec sec--tight clients">
    <h2 class="t-sub center reveal">{clients.title}</h2>
    <div class="marquee">
      {
        logoRows.map((row, r) => (
          <div class:list={["marquee__row", { "marquee__row--rev": r === 1 }]}>
            {[0, 1].map((dup) => (
              <ul aria-hidden={dup === 1 ? "true" : undefined}>
                {row.map((l: any) => (
                  <li>
                    <img src={l.src} alt={dup === 0 ? l.alt : ""} loading="lazy" />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Sustainability -->
  <section class="sec green">
    <div class="wrap">
      <div class="head reveal">
        <p class="t-eyebrow green__eyebrow">{green.title}</p>
        <h2 class="t-display">{green.subtitle}</h2>
        <p class="t-lead" set:html={green.text} />
        {green.cta && <a class="more" href={href(green.cta.href)}>{green.cta.text}</a>}
      </div>
      <div class="green__grid">
        {
          green.cards.map((c: any, i: number) => (
            <article class="gcard reveal" style={`--d:${i * 0.08}s`}>
              <div class="gcard__media">
                <img src={c.image} alt="" loading="lazy" />
              </div>
              <div class="gcard__body">
                <h3>{c.title}</h3>
                <p set:html={c.text} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Material and Services -->
  <section class="sec sec--alt">
    <div class="wrap">
      <h2 class="t-display center services__title reveal">{services.title}</h2>
      <div class="services">
        {
          services.cards.map((c: any, i: number) => (
            <a class="scard reveal" href={href(c.href)} style={`--d:${(i % 2) * 0.08}s`}>
              <div class="scard__media">
                <img src={c.image} alt="" loading="lazy" />
              </div>
              <div class="scard__body">
                {c.icon && <img src={c.icon} alt="" class="scard__icon" loading="lazy" />}
                <h3 class="t-sub">{c.title}</h3>
                <p>{c.text}</p>
                <span class="more">{c.cta}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Media -->
  <section class="sec">
    <div class="wrap">
      <div class="row-head reveal">
        <h2 class="t-display">{media.title}</h2>
        <a class="more" href={href("/gacl-news/")}>GACL News</a>
      </div>
      <div class="news">
        {
          media.items.map((n: any, i: number) => (
            <a class="ncard reveal" href={href(n.href)} style={`--d:${i * 0.08}s`}>
              <div class="media-frame ncard__media">
                <img src={n.image} alt="" loading="lazy" />
              </div>
              <p class="ncard__meta">
                <span>{n.label}</span> · <time>{n.date}</time>
              </p>
              <h3>{n.title}</h3>
              <span class="more">{n.cta}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="sec sec--alt quotes" data-quotes>
    <div class="wrap wrap--text">
      <h2 class="t-eyebrow center reveal">{testimonials.title}</h2>
      <div class="quotes__stage">
        {
          testimonials.items.map((q: any, i: number) => (
            <figure class:list={["quote", { "is-on": i === 0 }]} data-quote>
              <blockquote class="t-sub">{q.quote}</blockquote>
              <figcaption>
                <img src={q.image} alt="" loading="lazy" />
                <span>
                  <strong>{q.name}</strong>
                  <span>{q.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="quotes__dots">
        {testimonials.items.map((_: any, i: number) => <button type="button" aria-label={`Testimonial ${i + 1}`} aria-pressed={i === 0 ? "true" : "false"} data-qdot />)}
      </div>
    </div>
  </section>

  <!-- Investor information -->
  <section class="sec sec--tight">
    <div class="wrap">
      <div class="investor reveal">
        <div>
          <h2 class="t-display" set:html={investor.title} />
          <p class="t-lead">{investor.text}</p>
        </div>
        <div class="investor__links">
          {investor.links.map((l: any) => <a class="more" href={href(l.href)}>{l.text}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Quick links -->
  <section class="sec sec--tight quick-sec">
    <div class="wrap quick">
      {
        quick.map((q: any, i: number) => (
          <a class="qcard reveal" href={href(q.href)} style={`--d:${i * 0.08}s`}>
            {q.icon && <img src={q.icon} alt="" loading="lazy" />}
            <h3 class="t-sub">{q.title}</h3>
            <p>{q.text}</p>
            <span class="more">{q.cta}</span>
          </a>
        ))
      }
    </div>
  </section>

  <dialog class="vmodal" data-vmodal>
    <button type="button" class="vmodal__close" aria-label="Close video" data-vclose>×</button>
    <div class="vmodal__frame" data-vframe></div>
  </dialog>
</Base>

<script>
  // Hero: crossfading slides with autoplay, dots and pause.
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
  const dots = [...hero.querySelectorAll<HTMLButtonElement>("[data-dot]")];
  const pause = hero.querySelector<HTMLButtonElement>("[data-pause]")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let current = 0;
  let playing = !reduce;
  let timer: number | undefined;
  const show = (i: number) => {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, j) => s.classList.toggle("is-on", j === current));
    dots.forEach((d, j) => d.setAttribute("aria-selected", String(j === current)));
    hero.style.setProperty("--progress", "0");
    schedule();
  };
  const schedule = () => {
    clearTimeout(timer);
    hero.classList.toggle("is-paused", !playing);
    if (playing) timer = window.setTimeout(() => show(current + 1), 6500);
  };
  dots.forEach((d, i) => d.addEventListener("click", () => show(i)));
  pause.addEventListener("click", () => {
    playing = !playing;
    pause.setAttribute("aria-label", playing ? "Pause" : "Play");
    schedule();
  });
  schedule();

  // Product rail arrows.
  const track = document.querySelector<HTMLElement>("[data-track]")!;
  const step = () => (track.querySelector("li")?.getBoundingClientRect().width ?? 300) + 20;
  document.querySelector("[data-prev]")!.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
  document.querySelector("[data-next]")!.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));

  // Testimonials.
  const quotes = [...document.querySelectorAll<HTMLElement>("[data-quote]")];
  const qdots = [...document.querySelectorAll<HTMLButtonElement>("[data-qdot]")];
  let q = 0;
  const showQ = (i: number) => {
    q = (i + quotes.length) % quotes.length;
    quotes.forEach((el, j) => el.classList.toggle("is-on", j === q));
    qdots.forEach((d, j) => d.setAttribute("aria-pressed", String(j === q)));
  };
  qdots.forEach((d, i) => d.addEventListener("click", () => showQ(i)));
  if (!reduce) setInterval(() => showQ(q + 1), 8000);

  // Count-up figures.
  const fmt = new Intl.NumberFormat("en-IN");
  const counters = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      counters.unobserve(el);
      const target = Number(el.dataset.count);
      if (reduce || !target) return;
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 1800);
        el.textContent = fmt.format(Math.round(target * (1 - Math.pow(1 - p, 4))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => counters.observe(el));

  // Video modal.
  const modal = document.querySelector<HTMLDialogElement>("[data-vmodal]")!;
  const frame = modal.querySelector<HTMLElement>("[data-vframe]")!;
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((b) =>
    b.addEventListener("click", () => {
      frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${b.dataset.video}?autoplay=1" title="GACL video" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
      modal.showModal();
    }),
  );
  const closeModal = () => {
    modal.close();
    frame.innerHTML = "";
  };
  modal.querySelector("[data-vclose]")!.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => e.target === modal && closeModal());
  modal.addEventListener("close", () => (frame.innerHTML = ""));
</script>

<style>
  /* Ribbon */
  .ribbon {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 12px var(--gutter);
    background: var(--alt);
    color: var(--ink);
    font-size: 14px;
    text-align: center;
  }

  .ribbon:hover {
    text-decoration: none;
  }

  .ribbon .more {
    font-size: 14px;
  }

  /* Hero */
  .hero {
    position: relative;
    height: min(88vh, 900px);
    min-height: 560px;
    background: #000;
    overflow: hidden;
  }

  .hero__track,
  .slide {
    position: absolute;
    inset: 0;
  }

  .slide {
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .slide.is-on {
    opacity: 1;
  }

  .slide__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 8s linear;
  }

  .slide.is-on .slide__img {
    transform: scale(1);
  }

  .slide__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 30%, rgb(0 0 0 / 0.62) 100%);
  }

  .slide__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(88px, 12vh, 140px);
    display: grid;
    gap: 14px;
    justify-items: center;
    text-align: center;
    color: #fff;
  }

  .slide__title {
    max-width: 1000px;
    color: #fff;
    font-size: clamp(36px, 6vw, 80px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s 0.3s var(--ease), transform 1s 0.3s var(--ease);
  }

  .slide__text,
  .slide__sentence {
    max-width: 820px;
    color: rgb(255 255 255 / 0.92);
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.35;
    letter-spacing: -0.016em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s 0.45s var(--ease), transform 1s 0.45s var(--ease);
  }

  .slide__sentence {
    font-size: clamp(26px, 3.6vw, 48px);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .slide__sentence :global(a) {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: rgb(255 255 255 / 0.5);
  }

  .slide.is-on .slide__title,
  .slide.is-on .slide__text,
  .slide.is-on .slide__sentence {
    opacity: 1;
    transform: none;
  }

  .hero__controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .hero__dots {
    display: flex;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 980px;
    background: rgb(255 255 255 / 0.18);
    backdrop-filter: blur(12px);
  }

  .hero__dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 980px;
    background: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition: width 0.4s var(--ease), background 0.3s;
  }

  .hero__dots button[aria-selected="true"] {
    width: 28px;
    background: #fff;
  }

  .hero__pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
    backdrop-filter: blur(12px);
    cursor: pointer;
  }

  .i-pause {
    width: 10px;
    height: 12px;
    border-left: 3px solid #fff;
    border-right: 3px solid #fff;
  }

  .is-paused .i-pause {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent #fff;
    margin-left: 3px;
  }

  /* Figures */
  .figures__title {
    margin-bottom: clamp(32px, 5vw, 56px);
    font-size: 17px;
  }

  .figures__grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 860px) {
    .figures__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .figure + .figure {
      border-left: 1px solid var(--line);
    }
  }

  .figure {
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
    padding: 0 28px;
  }

  .figure__icon {
    width: 56px;
    height: 56px;
    object-fit: contain;
    opacity: 0.85;
  }

  .figure__value {
    white-space: nowrap;
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(120deg, #0a5ba3, #1a8cff 60%, #2f8f3a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .figure__unit {
    font-size: 0.5em;
    margin-left: 6px;
    letter-spacing: -0.02em;
  }

  .figure__text {
    max-width: 300px;
    font-size: 17px;
    color: var(--muted);
  }

  .figure__text :global(span),
  .figure__text :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  /* Company */
  .company {
    display: grid;
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .company {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .company__media {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3.3;
  }

  .company__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .company__badge {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    padding: 28px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
    color: #fff;
  }

  .company__badge > span {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .i-play {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent currentColor;
  }

  .company__title {
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.18;
  }

  .company__copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  /* Products rail */
  .rail {
    position: relative;
  }

  .rail__track {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 8px max(var(--gutter), calc((100vw - var(--wide)) / 2)) 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wide)) / 2));
    scrollbar-width: none;
  }

  .rail__track::-webkit-scrollbar {
    display: none;
  }

  .rail__item {
    flex: 0 0 auto;
    width: min(380px, 78vw);
    scroll-snap-align: start;
  }

  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--r-lg);
    background: var(--alt);
    overflow: hidden;
    color: var(--ink);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  .pcard:hover {
    text-decoration: none;
    transform: scale(1.02);
    box-shadow: var(--shadow-lg);
  }

  .pcard__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #fff;
  }

  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard__body {
    display: grid;
    gap: 8px;
    padding: 24px 28px 30px;
  }

  .pcard__body h3 {
    font-size: 24px;
    letter-spacing: -0.024em;
    line-height: 1.15;
  }

  .rail__nav {
    display: flex;
    justify-content: flex-end;
    gap: 14px;
  }

  .rail__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--alt-2);
    color: var(--ink);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .rail__btn:hover {
    background: var(--line);
  }

