---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Icon from "../../../components/Icon.astro";
import regions from "../../../data/dealers.json";
import { company } from "../../../data/site";

const total = regions.reduce((n, r) => n + r.dealers.length, 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<Base title="Dealer Network" description="Find an authorised GACL dealer near you, by region across India, or contact our export department.">
  <PageHero
    eyebrow="Dealer network"
    title="Buy GACL products near you."
    lead={`${total} authorised business partners across Gujarat, Maharashtra and other states, plus direct and export sales from Vadodara.`}
    crumbs={[{ label: "Materials & Services", href: "/partners/" }, { label: "Dealer Network" }]}
  >
    <div class="hero-actions">
      <a href={`mailto:${company.emails.export}`} class="btn"><Icon name="globe" /> Export enquiries</a>
      <a href={`mailto:${company.emails.marketing}`} class="btn btn--ghost">Domestic sales</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <nav class="regions" aria-label="Regions">
        <label class="search">
          <Icon name="search" size={18} />
          <input type="search" placeholder="Search city, dealer or email" data-dealer-search aria-label="Search dealers" />
        </label>
        <ul>
          {regions.map((r) => <li><a href={`#${slug(r.region)}`}>{r.region}<span>{r.dealers.length}</span></a></li>)}
        </ul>
      </nav>
      <div class="list">
        {
          regions.map((r) => (
            <section id={slug(r.region)} class="region" data-region>
              <h2 class="region__title">
                <Icon name="pin" size={20} /> {r.region}
              </h2>
              <div class="dealers">
                {r.dealers.map((d) => (
                  <article class="dealer" data-dealer data-text={`${d.details} ${d.contact} ${d.emails.join(" ")}`.toLowerCase()}>
                    <p class="dealer__details">{d.details}</p>
                    {d.contact && <p class="dealer__contact"><Icon name="user" size={16} /> {d.contact}</p>}
                    <div class="dealer__links">
                      {d.phone && <a href={`tel:${d.phone.replace(/[^\d+]/g, "")}`}><Icon name="phone" size={15} /> {d.phone}</a>}
                      {d.emails.slice(0, 2).map((e) => <a href={`mailto:${e}`}><Icon name="mail" size={15} /> {e}</a>)}
                      {d.website && <a href={`https://${d.website.replace(/^https?:\/\//, "")}`} target="_blank" rel="noopener"><Icon name="globe" size={15} /> {d.website.replace(/^https?:\/\//, "")}</a>}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
        <p class="none" data-dealer-empty hidden>No dealers match your search.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-dealer-search]")!;
  const dealers = [...document.querySelectorAll<HTMLElement>("[data-dealer]")];
  const regions = [...document.querySelectorAll<HTMLElement>("[data-region]")];
  const empty = document.querySelector<HTMLElement>("[data-dealer-empty]")!;
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    dealers.forEach((d) => (d.hidden = !!q && !d.dataset.text!.includes(q)));
    regions.forEach((r) => (r.hidden = !r.querySelector("[data-dealer]:not([hidden])")));
    empty.hidden = regions.some((r) => !r.hidden);
  });
</script>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .layout {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 280px 1fr;
      gap: 48px;
      align-items: start;
    }

    .regions {
      position: sticky;
      top: 140px;
    }
  }

  .regions {
    display: grid;
    gap: 16px;
  }

  .regions ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .regions a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 14.5px;
    color: var(--ink-2);
    transition: background 0.2s;
  }

  .regions a:hover {
    background: var(--brand-50);
    color: var(--brand-700);
  }

  .regions a span {
    font-size: 13px;
    color: var(--muted);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    min-height: 46px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    color: var(--muted);
    background: #fff;
  }

  .search:focus-within {
    border-color: var(--brand-500);
    box-shadow: 0 0 0 4px var(--brand-50);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: transparent;
  }

  .list {
    display: grid;
    gap: 40px;
  }

  .region {
    scroll-margin-top: 140px;
  }

  .region__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    margin-bottom: 16px;
  }

  .region__title :global(svg) {
    color: var(--brand-500);
  }

  .dealers {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 720px) {
    .dealers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dealer {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
  }

  .dealer__details {
    font-size: 14.5px;
    color: var(--ink);
    line-height: 1.5;
  }

  .dealer__contact {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }

  .dealer__links {
    display: grid;
    gap: 4px;
  }

  .dealer__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--brand-600);
    word-break: break-all;
  }

  .none {
    color: var(--muted);
  }
</style>
