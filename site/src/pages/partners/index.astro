---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { vendorLinks, company } from "../../data/site";
---

<Base title="Materials & Services" description="Supply to GACL: vendor pre-qualification, online and salt vendor registration, major raw materials, scrap disposal and tenders.">
  <PageHero
    eyebrow="Materials & services"
    title="Let’s grow together."
    lead="We buy salt, energy, equipment and services at scale for our complexes at Vadodara and Dahej. Register as a vendor, view our raw material needs or bid on open tenders."
    image="/images/salt.webp"
    imageAlt="Salt, GACL’s primary raw material"
    crumbs={[{ label: "Materials & Services" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          vendorLinks.map((v, i) => (
            <a href={v.href} class="card vend reveal" style={`--d:${(i % 3) * 0.05}s`} target="_blank" rel="noopener">
              <span class="icon-tile">
                <Icon name={v.icon} />
              </span>
              <h2 class="h3">{v.title}</h2>
              <p class="muted">{v.text}</p>
              <span class="link-arrow">Continue <Icon name="arrow-up-right" /></span>
            </a>
          ))
        }
        <a href="/partners/tenders/" class="card vend vend--accent reveal">
          <span class="icon-tile"><Icon name="briefcase" /></span>
          <h2 class="h3">Tenders</h2>
          <p class="muted">Open tenders and expressions of interest.</p>
          <span class="link-arrow">View tenders <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container contact">
      <img src="/images/raw-materials.webp" alt="Raw materials handling" loading="lazy" />
      <div>
        <p class="eyebrow">Purchase department</p>
        <h2 class="h2">Questions about supplying GACL?</h2>
        <p class="lead">Write to our purchase team with your company profile and the materials or services you offer.</p>
        <a href={`mailto:${company.emails.purchase}`} class="btn"><Icon name="mail" /> {company.emails.purchase}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .vend {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .vend--accent {
    background: linear-gradient(150deg, var(--brand-50), #fff 60%);
    border-color: var(--brand-100);
  }

  .contact {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  .contact img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .contact > div {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
</style>
