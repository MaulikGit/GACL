---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Icon from "../../../components/Icon.astro";
import tenders from "../../../data/tenders.json";

const parse = (d: string) => {
  const [dd, mm, yyyy] = d.split(".").map(Number);
  return new Date(yyyy, mm - 1, dd, 23, 59);
};
const now = new Date();
const rows = tenders.map((t) => ({ ...t, isOpen: parse(t.close) >= now }));
const openCount = rows.filter((r) => r.isOpen).length;
---

<Base title="Tenders" description="Open tenders and expressions of interest from Gujarat Alkalies and Chemicals Limited.">
  <PageHero
    eyebrow="Tenders"
    title="Open tenders & expressions of interest."
    lead="Download tender documents and submission formats. Closing dates are firm. Please read every document before you submit."
    crumbs={[{ label: "Materials & Services", href: "/partners/" }, { label: "Tenders" }]}
  >
    <span class:list={["chip", { "chip--green": openCount > 0, "chip--plain": openCount === 0 }]}>
      {openCount > 0 ? `${openCount} open now` : "No tenders open right now"}
    </span>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="tenders">
        {
          rows.map((t) => (
            <article class="tender reveal">
              <div class="tender__main">
                <span class:list={["chip", t.isOpen ? "chip--green" : "chip--plain"]}>{t.isOpen ? "Open" : "Closed"}</span>
                <h2 class="h3">{t.title}</h2>
                <dl class="tender__dates">
                  <div><dt>Opens</dt><dd>{t.open}</dd></div>
                  <div><dt>Closes</dt><dd>{t.close}</dd></div>
                </dl>
              </div>
              <div class="tender__docs">
                {t.documents.map((d) => (
                  <a href={d.url} class="btn btn--ghost btn--sm" target="_blank" rel="noopener">
                    <Icon name="download" size={16} /> {d.label.replace(/^\d+\.\s*/, "")}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <div class="empty card">
        <Icon name="calendar" />
        <div>
          <h2 class="h3">Looking for older tenders or scrap lots?</h2>
          <p class="muted">See <a href="https://gacl.com/scrap-for-disposal/" target="_blank" rel="noopener">scrap for disposal</a> or write to <a href="mailto:purchase@gacl.co.in">purchase@gacl.co.in</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .tenders {
    display: grid;
    gap: 16px;
  }

  .tender {
    display: grid;
    gap: 20px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  @media (min-width: 900px) {
    .tender {
      grid-template-columns: 1.6fr 1fr;
      align-items: center;
    }
  }

  .tender__main {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .tender__dates {
    display: flex;
    gap: 28px;
    margin: 4px 0 0;
  }

  .tender__dates dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tender__dates dd {
    margin: 2px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .tender__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (min-width: 900px) {
    .tender__docs {
      justify-content: flex-end;
    }
  }

  .empty {
    display: flex;
    gap: 16px;
    margin-top: 24px;
    background: var(--surface);
  }

  .empty :global(svg) {
    flex-shrink: 0;
    color: var(--brand-500);
  }

  .empty a {
    color: var(--brand-600);
    font-weight: 500;
  }
</style>
