---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { investorLinks, investorContact, company } from "../../data/site";
---

<Base title="Investors" description="GACL investor centre: financial results, shareholding pattern, corporate governance, credit ratings, BRSR and investor grievance contact.">
  <PageHero
    eyebrow="Investor centre"
    title="Transparent reporting for every shareholder."
    lead="Gujarat Alkalies and Chemicals Limited is listed on the BSE and NSE. Find our filings, reports and the people to contact here."
    crumbs={[{ label: "Investors" }]}
  >
    <div class="tickers">
      <span class="chip">NSE: GUJALKALI</span>
      <span class="chip">BSE: 530001</span>
      <span class="chip chip--plain">CIN {company.cin}</span>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          investorLinks.map((l, i) => (
            <a href={l.href} class="card inv reveal" style={`--d:${(i % 3) * 0.05}s`} target="_blank" rel="noopener">
              <span class="icon-tile">
                <Icon name={l.icon} />
              </span>
              <h2 class="h3">{l.title}</h2>
              <p class="muted">{l.text}</p>
              <span class="link-arrow">
                Open <Icon name="arrow-up-right" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" id="connect">
    <div class="container connect">
      <div>
        <p class="eyebrow">Investors connect</p>
        <h2 class="h2">Investor grievance redressal</h2>
        <p class="lead">For questions about shares, dividends, transfers or dematerialisation, contact our compliance officer.</p>
      </div>
      <div class="card officer">
        <div class="officer__head">
          <span class="icon-tile"><Icon name="user" /></span>
          <div>
            <h3 class="h3">{investorContact.name}</h3>
            <p class="muted">{investorContact.role}</p>
          </div>
        </div>
        <dl>
          <div><dt><Icon name="pin" size={18} /> Address</dt><dd>{investorContact.address}</dd></div>
          <div><dt><Icon name="phone" size={18} /> Phone</dt><dd><a href="tel:+912656111000">{investorContact.phone}</a></dd></div>
          <div><dt><Icon name="doc" size={18} /> Fax</dt><dd>{investorContact.fax}</dd></div>
          <div><dt><Icon name="mail" size={18} /> Email</dt><dd><a href={`mailto:${investorContact.email}`}>{investorContact.email}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .tickers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .inv {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .inv .link-arrow {
    margin-top: 6px;
  }

  .connect {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .connect {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }

  .connect > div:first-child {
    display: grid;
    gap: 16px;
  }

  .officer__head {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .officer dl {
    margin: 0;
    display: grid;
  }

  .officer dl > div {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .officer dl > div:last-child {
    border-bottom: 0;
  }

  @media (min-width: 560px) {
    .officer dl > div {
      grid-template-columns: 120px 1fr;
      gap: 16px;
    }
  }

  .officer dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .officer dd {
    margin: 0;
  }

  .officer a {
    color: var(--brand-600);
    font-weight: 500;
  }
</style>
