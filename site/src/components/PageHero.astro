---
interface Props {
  title: string;
  eyebrow?: string;
  image?: string;
}
const { title, eyebrow, image } = Astro.props;
---

<section class="phero">
  <div class="wrap wrap--text phero__copy">
    {eyebrow && <p class="t-eyebrow phero__eyebrow">{eyebrow}</p>}
    <h1 class="t-hero">{title}</h1>
    <slot />
  </div>
  {
    image && (
      <div class="wrap phero__media">
        <div class="phero__frame">
          <img src={image} alt="" fetchpriority="high" />
        </div>
      </div>
    )
  }
</section>

<style>
  .phero {
    padding-top: clamp(56px, 9vw, 120px);
    padding-bottom: clamp(48px, 6vw, 80px);
    text-align: center;
  }

  .phero__copy {
    display: grid;
    gap: 16px;
    justify-items: center;
    animation: rise 1s var(--ease) both;
  }

  .phero__media {
    margin-top: clamp(40px, 6vw, 72px);
    animation: rise 1.2s 0.1s var(--ease) both;
  }

  .phero__frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: var(--alt);
  }

  @media (max-width: 700px) {
    .phero__frame {
      aspect-ratio: 4 / 3;
    }
  }

  .phero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
