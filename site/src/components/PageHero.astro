---
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
  crumbs?: { label: string; href?: string }[];
  green?: boolean;
}
const { eyebrow, title, lead, image, imageAlt = "", crumbs = [], green = false } = Astro.props;
---

<section class:list={["page-hero", { "page-hero--image": image }]}>
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((c) => (
              <>
                <Icon name="chevron" size={14} class="crumbs__sep" />
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <p class:list={["eyebrow", { "eyebrow--green": green }]}>{eyebrow}</p>
      <h1 class="page-hero__title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="page-hero__media">
          <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .page-hero__glow {
    position: absolute;
    inset: -40% -10% auto;
    height: 120%;
    background:
      radial-gradient(40% 50% at 20% 30%, rgb(23 130 216 / 0.1), transparent 70%),
      radial-gradient(30% 40% at 85% 20%, rgb(58 169 53 / 0.08), transparent 70%);
    pointer-events: none;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(11 47 87 / 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .page-hero--image .page-hero__inner {
      grid-template-columns: 1.05fr 1fr;
      gap: 64px;
    }
  }

  .page-hero__copy {
    display: grid;
    gap: 18px;
    max-width: 760px;
    justify-items: start;
  }

  .page-hero__title {
    font-size: clamp(36px, 5.4vw, 64px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .page-hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-3);
    aspect-ratio: 4 / 3;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--brand-600);
  }

  .crumbs span[aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  :global(.crumbs__sep) {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
</style>
