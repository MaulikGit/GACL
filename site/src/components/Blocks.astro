---
import type { Block } from "../lib/content";
import { href, youtubeId, plain } from "../lib/content";
import Blocks from "./Blocks.astro";

interface Props {
  blocks: Block[];
  firstHeadingLarge?: boolean;
}
const { blocks, firstHeadingLarge = false } = Astro.props;
let headingSeen = false;
const isDoc = (u: string) => /\.(pdf|docx?|xlsx?|pptx?|zip)(\?|$)/i.test(u);
const headingClass = (level: number, big: boolean) =>
  big ? "b-h b-h--big t-title" : level <= 2 ? "b-h b-h--2 t-sub" : level === 3 ? "b-h b-h--3" : "b-h b-h--4";
const headingTag = (level: number, big: boolean) => (big ? "h2" : `h${Math.min(Math.max(level, 2), 4)}`);
const isChips = (items: string[]) => items.length >= 4 && items.every((i) => plain(i).length <= 40);
const cardCols = (n: number) => `b-cards--${Math.min(n, 4)}`;
const iconCards = (items: { image: string }[]) => items.every((c) => !c.image || c.image.endsWith(".svg"));
const fewImages = (n: number) => n <= 3;
const linkList = (items: string[]) => items.length > 1 && items.every((i) => /^<a [^>]+>[^<]*<\/a>$/.test(i.trim()));
---

{
  blocks.map((b) => {
    if (b.type === "eyebrow") return <p class="b-eyebrow t-eyebrow">{b.text}</p>;
    if (b.type === "heading") {
      const big = firstHeadingLarge && !headingSeen;
      headingSeen = true;
      const cls = headingClass(b.level, big);
      const Tag = headingTag(b.level, big) as any;
      return <Tag class={cls}>{b.text}</Tag>;
    }
    if (b.type === "text") return <p class="b-text rich" set:html={b.html} />;
    if (b.type === "list") {
      if (linkList(b.items)) {
        return (
          <ul class="b-links">
            {b.items.map((i) => {
              const m = i.match(/href="([^"]*)"[^>]*>([^<]*)</);
              const u = m ? m[1] : "#";
              return (
                <li>
                  <a href={href(u)} target={isDoc(u) ? "_blank" : undefined} rel={isDoc(u) ? "noopener" : undefined}>
                    <span>{m ? m[2] : plain(i)}</span>
                    <span class="b-links__go" aria-hidden="true">{isDoc(u) ? "PDF" : ""}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        );
      }
      const Tag = (b.ordered ? "ol" : "ul") as any;
      return (
        <Tag class:list={["b-list rich", { "b-list--chips": isChips(b.items) }]}>
          {b.items.map((i) => <li set:html={i} />)}
        </Tag>
      );
    }
    if (b.type === "image")
      return (
        <figure class="b-img">
          {b.href ? (
            <a href={href(b.href)} target={isDoc(b.href) ? "_blank" : undefined}>
              <img src={b.src} alt={b.alt} loading="lazy" />
            </a>
          ) : (
            <img src={b.src} alt={b.alt} loading="lazy" />
          )}
          {b.caption && <figcaption>{b.caption}</figcaption>}
        </figure>
      );
    if (b.type === "gallery")
      return (
        <div class:list={["b-gallery", { "b-gallery--few": fewImages(b.images.length) }]}>
          {b.images.map((g) => (
            <figure class="media-frame">
              <img src={g.src} alt={g.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      );
    if (b.type === "cards")
      return (
        <div class:list={["b-cards", cardCols(b.items.length), { "b-cards--icons": iconCards(b.items) }]}>
          {b.items.map((c) => {
            const inner = (
              <>
                {c.image && (
                  <div class="b-card__media">
                    <img src={c.image} alt="" loading="lazy" />
                  </div>
                )}
                <div class="b-card__body">
                  {c.title && <h3 class="b-card__title">{c.title}</h3>}
                  {c.html && <p class="b-card__text" set:html={c.html} />}
                  {c.href && <span class="more">{c.cta || "Learn more"}</span>}
                </div>
              </>
            );
            return c.href ? (
              <a class="b-card" href={href(c.href)} target={isDoc(c.href) ? "_blank" : undefined}>{inner}</a>
            ) : (
              <div class="b-card">{inner}</div>
            );
          })}
        </div>
      );
    if (b.type === "table") {
      const [head, ...rows] = b.rows;
      return (
        <div class="b-table">
          <table>
            <thead>
              <tr>{head.map((c) => <th set:html={c} />)}</tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>{r.map((c) => <td set:html={c} />)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    }
    if (b.type === "accordion")
      return (
        <div class="b-acc">
          {b.items.map((it, i) => (
            <details open={i === 0}>
              <summary>
                <span>{it.title}</span>
                <span class="b-acc__icon" aria-hidden="true" />
              </summary>
              <div class="b-acc__body">
                <Blocks blocks={it.blocks} />
              </div>
            </details>
          ))}
        </div>
      );
    if (b.type === "button")
      return isDoc(b.href) ? (
        <a class="pill pill--ghost pill--sm b-btn" href={href(b.href)} target="_blank" rel="noopener">{b.text}</a>
      ) : (
        <a class="more b-btn" href={href(b.href)}>{b.text}</a>
      );
    if (b.type === "video") {
      const id = youtubeId(b.url);
      return id ? (
        <div class="b-video media-frame">
          <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title="Video" loading="lazy" allowfullscreen />
        </div>
      ) : (
        <a class="more" href={b.url}>Watch video</a>
      );
    }
    if (b.type === "embed")
      return (
        <div class="b-embed media-frame">
          <iframe src={b.src} title="Embedded content" loading="lazy" />
        </div>
      );
    if (b.type === "stat")
      return (
        <div class="b-stat">
          <strong>{b.value}{b.suffix}</strong>
          <span>{b.label}</span>
        </div>
      );
    return null;
  })
}

<style>
  .b-eyebrow {
    margin-bottom: -4px;
  }

  .b-h--big {
    margin-bottom: 8px;
  }

  .b-h--2 {
    margin-top: 24px;
  }

  .b-h--3 {
    margin-top: 20px;
    font-size: clamp(21px, 1.8vw, 24px);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .b-h--4 {
    margin-top: 16px;
    font-size: 19px;
    letter-spacing: -0.016em;
  }

  :global(.blocks > :first-child) {
    margin-top: 0;
  }

  .b-list {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }

  .b-list li::marker {
    color: var(--faint);
  }

  .b-list--chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .b-list--chips li {
    padding: 8px 16px;
    border-radius: 980px;
    background: var(--alt);
    font-size: 15px;
    color: var(--ink);
  }

  :global(.sec--alt) .b-list--chips li {
    background: #fff;
  }

  .b-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .b-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 2px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 17px;
  }

  .b-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .b-links__go {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }

  .b-links__go:empty::after {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-top: 1.6px solid var(--faint);
    border-right: 1.6px solid var(--faint);
    transform: rotate(45deg);
  }

  .b-img {
    margin: 8px 0;
  }

  .b-img img {
    width: 100%;
    border-radius: var(--r);
  }

  .b-img figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .b-gallery {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin: 16px 0;
  }

  .b-gallery figure {
    margin: 0;
    aspect-ratio: 4 / 3;
  }

  .b-cards {
    display: grid;
    gap: 20px;
    margin: 16px 0;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  @media (min-width: 900px) {
    .b-cards--2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .b-cards--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .b-cards--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .b-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    background: var(--alt);
    overflow: hidden;
    color: var(--ink);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  :global(.sec--alt) .b-card {
    background: #fff;
  }

  a.b-card:hover {
    text-decoration: none;
    transform: scale(1.015);
    box-shadow: var(--shadow-lg);
  }

  .b-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .b-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .b-cards--icons .b-card__media {
    aspect-ratio: auto;
    padding: 28px 28px 0;
  }

  .b-cards--icons .b-card__media img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .b-card__body {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px 28px 30px;
    flex: 1;
  }

  .b-card__title {
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .b-card__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .b-card .more {
    margin-top: 4px;
  }

  .b-table {
    overflow-x: auto;
    margin: 12px 0;
    border-radius: var(--r);
    background: var(--alt);
  }

  :global(.sec--alt) .b-table {
    background: #fff;
  }

  .b-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    min-width: 480px;
  }

  .b-table th,
  .b-table td {
    padding: 14px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hair);
  }

  .b-table th {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.01em;
  }

  .b-table tr:last-child td {
    border-bottom: 0;
  }

  .b-table td :global(a) {
    color: var(--accent);
  }

  .b-acc {
    border-top: 1px solid var(--line);
    margin: 8px 0;
  }

  .b-acc details {
    border-bottom: 1px solid var(--line);
  }

  .b-acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    font-size: clamp(19px, 1.6vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    cursor: pointer;
    list-style: none;
  }

  .b-acc summary::-webkit-details-marker {
    display: none;
  }

  .b-acc__icon {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .b-acc__icon::before,
  .b-acc__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 1.6px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .b-acc__icon::after {
    transform: rotate(90deg);
  }

  details[open] .b-acc__icon::after {
    transform: rotate(0);
  }

  .b-acc__body {
    display: grid;
    gap: 16px;
    padding: 0 0 28px;
  }

  .b-btn {
    justify-self: start;
    margin-top: 4px;
  }

  .b-video,
  .b-embed {
    aspect-ratio: 16 / 9;
    margin: 12px 0;
  }

  .b-video iframe,
  .b-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .b-stat {
    display: grid;
    gap: 4px;
  }

  .b-stat strong {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
</style>
