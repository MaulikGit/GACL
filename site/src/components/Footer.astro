---
import { footer, nav, href } from "../lib/content";

const year = new Date().getFullYear();
const menuCols = nav.filter((g) => g.children.length);
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__cols">
      {
        menuCols.map((g) => (
          <nav class="foot__col" aria-label={g.label}>
            <h3>{g.label}</h3>
            <ul>
              {g.children.map((c) => (
                <li><a href={href(c.href)}>{c.label}</a></li>
              ))}
            </ul>
          </nav>
        ))
      }
      {
        footer.columns
          .filter((c) => c.title === "Quick Links")
          .map((c) => (
            <nav class="foot__col" aria-label={c.title}>
              <h3>{c.title}</h3>
              <ul>
                {c.links.map((l) => (
                  <li><a href={href(l.href)}>{l.text}</a></li>
                ))}
              </ul>
            </nav>
          ))
      }
    </div>

    <div class="foot__sites">
      {
        footer.sites.map((s) => (
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>

    <div class="foot__legal">
      <div class="foot__brand">
        <img src="/brand/gacl-logo.png" alt="GACL" width="72" height="57" loading="lazy" />
        <div>
          {footer.legal.map((l) => <p>{l}</p>)}
        </div>
      </div>
      <div class="foot__social">
        {
          footer.social.map((s) => (
            <a href={s.href} target="_blank" rel="noopener">{s.label || new URL(s.href).hostname.replace("www.", "").split(".")[0]}</a>
          ))
        }
      </div>
    </div>
    <p class="foot__copy">Copyright © {year} Gujarat Alkalies and Chemicals Limited. All rights reserved.</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--alt);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.33;
    letter-spacing: -0.01em;
  }

  .foot__inner {
    max-width: calc(1240px + var(--gutter) * 2);
    margin: 0 auto;
    padding: 40px var(--gutter) 24px;
  }

  .foot h3 {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .foot a {
    color: var(--ink-2);
  }

  .foot a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .foot__cols {
    display: grid;
    gap: 28px 20px;
    grid-template-columns: repeat(2, 1fr);
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .foot__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .foot__cols {
      grid-template-columns: repeat(9, 1fr);
    }
  }

  .foot__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .foot__sites {
    display: grid;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .foot__sites {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  .foot__sites p {
    max-width: 320px;
  }

  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding: 20px 0 12px;
  }

  .foot__brand {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .foot__brand img {
    width: 56px;
    height: auto;
  }

  .foot__brand p + p {
    margin-top: 4px;
  }

  .foot__social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .foot__social a {
    text-transform: capitalize;
  }

  .foot__copy {
    padding-top: 8px;
  }
</style>
